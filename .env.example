# Server-only Vercel access token with permission to read Web Analytics.
VERCEL_ANALYTICS_TOKEN=

# Optional overrides. VERCEL_PROJECT_ID is normally supplied by Vercel when
# system environment variables are exposed to the deployment.
VERCEL_ANALYTICS_PROJECT_ID=

# Required only when the project belongs to a Vercel team. Personal projects
# omit this value.
VERCEL_ANALYTICS_TEAM_ID=

# Public HTTPS URL serving the sanitized BTCUSDT 5m observatory JSON bundle.
# The source must permit CORS from the deployed website origin.
NEXT_PUBLIC_BTC_RESEARCH_OBSERVATORY_URL=

# Legacy optional direct override for the BTCUSDT-only Binance position feed.
# Retained for backward compatibility with the existing V1 page/feed contract.
NEXT_PUBLIC_BTC_LIVE_POSITION_URL=

# Optional direct override for the account-wide Binance USD-M open-position feed.
# The variable name is retained for deployment compatibility. A legacy URL ending
# in /multi-symbol-position.json is rewritten to /public/execution/open-positions.json.
# When omitted, the site derives the V2 path from the observatory origin and finally
# falls back to btc-data.meanydeany.com.
NEXT_PUBLIC_BTC_MULTI_POSITION_URL=

# Optional direct override for V2 flow-adjusted performance telemetry. The UI exposes
# account-wide trading PnL and return since 2026-08-01 while neutralizing deposits,
# withdrawals, transfers, and non-trading rewards. When omitted, the site derives the
# feed from the observatory origin and finally falls back to btc-data.meanydeany.com.
NEXT_PUBLIC_BTC_LIFETIME_PERFORMANCE_URL=

# Optional private-deployment path for licensed TradingView Advanced Charts
# assets, for example /charting_library/. Leave blank to use the built-in
# evidence chart. Do not commit TradingView proprietary library files here.
NEXT_PUBLIC_TRADINGVIEW_CHARTING_LIBRARY_PATH=
