# Server-only Vercel access token with permission to read Web Analytics.
VERCEL_ANALYTICS_TOKEN=

# Optional overrides. VERCEL_PROJECT_ID is normally supplied by Vercel when
# system environment variables are exposed to the deployment.
VERCEL_ANALYTICS_PROJECT_ID=

# Required only when the project belongs to a Vercel team. Personal projects
# omit this value.
VERCEL_ANALYTICS_TEAM_ID=

# Public HTTPS URL serving the sanitized BTCUSDT 5m observatory JSON bundle.
# The source must permit CORS from the deployed website origin.
NEXT_PUBLIC_BTC_RESEARCH_OBSERVATORY_URL=

# Optional direct override for the public sanitized BTCUSDT Binance position feed.
# When omitted, the site derives the execution feed from the observatory origin and
# finally falls back to the public btc-data.meanydeany.com endpoint.
NEXT_PUBLIC_BTC_LIVE_POSITION_URL=

# Optional private-deployment path for licensed TradingView Advanced Charts
# assets, for example /charting_library/. Leave blank to use the built-in
# evidence chart. Do not commit TradingView proprietary library files here.
NEXT_PUBLIC_TRADINGVIEW_CHARTING_LIBRARY_PATH=
